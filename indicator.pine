//@version=6
indicator('Sniper V6.6 Pro', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// --- 1. MOVING AVERAGES ---
g1 = '1. Moving Averages'
show_ema     = input.bool(true, 'Show EMAs', group = g1)
ema_fast_len = input.int(14, 'Fast EMA', group = g1, inline = 'ema1')
ema_fast_col = input.color(color.white, '', group = g1, inline = 'ema1')
ema_mid_len  = input.int(50, 'Intermediate EMA', group = g1, inline = 'ema2')
ema_mid_col  = input.color(color.blue, '', group = g1, inline = 'ema2')
ema_slow_len = input.int(200, 'Macro EMA', group = g1, inline = 'ema3')
ema_slow_col = input.color(color.red, '', group = g1, inline = 'ema3')

// --- 2. VWAP ---
g2 = '2. VWAP'
show_vwap = input.bool(true, 'Show VWAP', group = g2, inline = 'vwap')
vwap_col  = input.color(color.yellow, 'Color', group = g2, inline = 'vwap')

// --- 3. FVG ---
g3 = '3. FVG'
show_fvg = input.bool(true, 'Show Boxes', group = g3)
color_bull_fvg = input.color(color.aqua, 'Bullish', group = g3, inline = 'fvg_col')
color_bear_fvg = input.color(color.red, 'Bearish', group = g3, inline = 'fvg_col')
bg_transp = input.int(85, 'Background Transp.', group = g3)
border_transp = input.int(50, 'Border Transp.', group = g3)
fvg_proj_bars = input.int(15, 'Projection Bars', group = g3)

// --- 4. TRIGGERS ---
g4 = '4. Sensitivity (Triggers)'
show_signals = input.bool(true, 'Show Signals', group = g4)
color_long  = input.color(color.green, 'LONG', group = g4, inline = 'sig_col')
color_short = input.color(color.red, 'SHORT', group = g4, inline = 'sig_col')
wick_multiplier = input.float(1.5, 'Sweep Wick Size (x Body)', step = 0.1, group = g4, tooltip="The sweep wick must be at least this many times larger than the candle body.")
opp_wick_max = input.float(0.6, 'Max Opposite Wick (x Body)', step = 0.1, group = g4, tooltip="The non-sweeping wick must be smaller than this times the candle body.")

// --- 5. VOLUME ---
g5 = '5. Volume'
use_vol_filter = input.bool(true, 'Volume Filter', group = g5)
vol_ma_len = input.int(20, 'Average Period', group = g5)
vol_multiplier = input.float(1.1, 'Volume Multiplier', step = 0.1, group = g5)

// --- 6. CVD DIVERGENCE ---
g6 = '6. Delta Divergence (CVD)'
show_cvd = input.bool(true, 'Show CVD Border', group = g6)
c_cvd_bull = input.color(color.new(color.aqua, 20), 'Bullish Border (Aqua)', group = g6)
c_cvd_bear = input.color(color.new(color.fuchsia, 20), 'Bearish Border (Fuchsia)', group = g6)

// --- 7. ORB (Opening Range Breakout) ---
g7 = '7. ORB (Opening Range)'
show_orb = input.bool(true, 'Show ORB', group = g7)
orb_sess = input.session('0915-0930', 'ORB Time', group = g7)
tz_kolkata = 'Asia/Kolkata'
color_orb = input.color(color.orange, 'Line Color', group = g7)
orb_sty_str = input.string('Dotted', 'Line Style', options=['Solid', 'Dashed', 'Dotted'], group = g7)
show_orb_lbl = input.bool(true, 'Show Labels (ORB-H/L)', group = g7)

// ==========================================
// --- DELTA DIVERGENCE LOGIC ---
// ==========================================
candle_delta = close > open ? volume : close < open ? -volume : 0
cvd = ta.cum(candle_delta)

bull_div = low < low[1] and cvd > cvd[1] and close > open
bear_div = high > high[1] and cvd < cvd[1] and close < open

color_border = na
if show_cvd and bull_div
    color_border := c_cvd_bull
else if show_cvd and bear_div
    color_border := c_cvd_bear

barcolor(color_border, title = 'Divergence Border Color')

// ==========================================
// --- HORIZONTAL PRECISION ORB LOGIC ---
// ==========================================
orb_sty = orb_sty_str == 'Solid' ? line.style_solid : orb_sty_str == 'Dashed' ? line.style_dashed : line.style_dotted

var float calc_orb_h = na
var float calc_orb_l = na
var line l_orb_h = na
var line l_orb_l = na
var label lb_orb_h = na
var label lb_orb_l = na

time_orb = time("", orb_sess, tz_kolkata)
in_calc_sess = not na(time_orb)
is_first_calc_bar = not na(time_orb) and na(time_orb[1])
is_orb_session_end = na(time_orb) and not na(time_orb[1])
is_new_day = time("D", tz_kolkata) != time("D", tz_kolkata)[1]

if is_new_day
    calc_orb_h := na
    calc_orb_l := na
    if show_orb
        line.delete(l_orb_h)
        line.delete(l_orb_l)
        label.delete(lb_orb_h)
        label.delete(lb_orb_l)

if in_calc_sess
    if is_first_calc_bar
        calc_orb_h := high
        calc_orb_l := low
    else
        calc_orb_h := math.max(calc_orb_h, high)
        calc_orb_l := math.min(calc_orb_l, low)

if is_orb_session_end and show_orb
    l_orb_h := line.new(bar_index, calc_orb_h, bar_index + 1, calc_orb_h, color = color_orb, style = orb_sty, width = 1, extend = extend.right)
    l_orb_l := line.new(bar_index, calc_orb_l, bar_index + 1, calc_orb_l, color = color_orb, style = orb_sty, width = 1, extend = extend.right)
    
    if show_orb_lbl
        lb_orb_h := label.new(bar_index, calc_orb_h, 'ORB-H', color = color.new(color.white, 100), textcolor = color_orb, style = label.style_label_down, size = size.small)
        lb_orb_l := label.new(bar_index, calc_orb_l, 'ORB-L', color = color.new(color.white, 100), textcolor = color_orb, style = label.style_label_up, size = size.small)

if not na(l_orb_h) and show_orb_lbl
    label.set_x(lb_orb_h, bar_index)
    label.set_x(lb_orb_l, bar_index)


// ==========================================
// --- MAIN CALCULATIONS ---
// ==========================================
var bullish_boxes = array.new<box>()
var bearish_boxes = array.new<box>()

// Moving Averages and VWAP
ema_fast = ta.ema(close, ema_fast_len)
ema_mid  = ta.ema(close, ema_mid_len)
ema_slow = ta.ema(close, ema_slow_len)
vwap_val = ta.vwap(close)

plot(show_ema ? ema_fast : na, color = ema_fast_col, linewidth = 2, title="Fast EMA")
plot(show_ema ? ema_mid : na, color = ema_mid_col, linewidth = 2, title="Mid EMA")
plot(show_ema ? ema_slow : na, color = ema_slow_col, linewidth = 2, title="Slow EMA")
plot(show_vwap ? vwap_val : na, color = vwap_col, title="VWAP")

// FVG Colors
bg_bull_col = color.new(color_bull_fvg, bg_transp)
border_bull_col = color.new(color_bull_fvg, border_transp)
bg_bear_col = color.new(color_bear_fvg, bg_transp)
border_bear_col = color.new(color_bear_fvg, border_transp)

idx_2_bars_ago = bar_index[2]
idx_proj = bar_index + fvg_proj_bars
high_2_bars_ago = high[2]
low_2_bars_ago = low[2]

// Detect and draw Bullish FVG
if show_fvg and low > high_2_bars_ago
    new_box = box.new(idx_2_bars_ago, low, idx_proj, high_2_bars_ago, border_color = border_bull_col, bgcolor = bg_bull_col)
    array.push(bullish_boxes, new_box)

// Detect and draw Bearish FVG
if show_fvg and high < low_2_bars_ago
    new_box = box.new(idx_2_bars_ago, low_2_bars_ago, idx_proj, high, border_color = border_bear_col, bgcolor = bg_bear_col)
    array.push(bearish_boxes, new_box)

// Clean up mitigated Bullish FVGs
size_bull = array.size(bullish_boxes)
if size_bull > 0
    for i = size_bull - 1 to 0 by 1
        current_box = array.get(bullish_boxes, i)
        box.set_right(current_box, idx_proj) // Extend box as time passes
        
        // If price mitigates (drops below) the FVG, remove it
        if low <= box.get_bottom(current_box)
            box.delete(current_box)
            array.remove(bullish_boxes, i)

// Clean up mitigated Bearish FVGs
size_bear = array.size(bearish_boxes)
if size_bear > 0
    for i = size_bear - 1 to 0 by 1
        current_box = array.get(bearish_boxes, i)
        box.set_right(current_box, idx_proj)
        
        if high >= box.get_top(current_box)
            box.delete(current_box)
            array.remove(bearish_boxes, i)

// Anatomy of the Candle
candle_body = math.max(math.abs(close - open), syminfo.mintick)
wick_upper  = high - math.max(close, open)
wick_lower  = math.min(close, open) - low

// Trigger Conditions
touch_fast_ema = low <= ema_fast and high >= ema_fast
touch_vwap     = low <= vwap_val and high >= vwap_val
touch_key_level = touch_fast_ema or touch_vwap

vol_sma = ta.sma(volume, vol_ma_len)
vol_condition = use_vol_filter ? volume >= (vol_sma * vol_multiplier) : true

// Long Entry Sweep
long_sweep_structure = wick_lower >= (candle_body * wick_multiplier) and wick_upper <= (candle_body * opp_wick_max)
signal_long = long_sweep_structure and touch_key_level and close > open and vol_condition

// Short Entry Sweep
short_sweep_structure = wick_upper >= (candle_body * wick_multiplier) and wick_lower <= (candle_body * opp_wick_max)
signal_short = short_sweep_structure and touch_key_level and close < open and vol_condition

// Plotting Signals
plotshape(show_signals and signal_long, 'LONG', shape.triangleup, location.belowbar, color_long, text = 'LONG', textcolor = color_long, size = size.small)
plotshape(show_signals and signal_short, 'SHORT', shape.triangledown, location.abovebar, color_short, text = 'SHORT', textcolor = color_short, size = size.small)

alertcondition(signal_long, 'LONG', 'Bullish Sweep')
alertcondition(signal_short, 'SHORT', 'Bearish Sweep')