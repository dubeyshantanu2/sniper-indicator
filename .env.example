# Dhan API Credentials
# Get these from your DhanHQ Developer Dashboard
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# Supabase Database Credentials
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Discord Notifications
# Create a webhook in your Discord Server Channel Settings -> Integrations
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token